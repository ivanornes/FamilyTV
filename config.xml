<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://ornes.family/CasaTV"
        version="1.0.2"
        viewmodes="maximized">

    <!-- package id: exactamente 10 caracteres alfanuméricos -->
    <tizen:application id="CasaTV0001.CasaTV" package="CasaTV0001" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>

    <name>Casa TV</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Ventana de TV (mostrar la señal HDMI dentro de la app) -->
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <!-- Teclas de colores y números del mando -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- Sólo para la estrategia SmartThings (opcional) -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <access origin="https://api.smartthings.com" subdomains="true"/>
    <!-- Calendario (feeds iCal de iCloud y Google) -->
    <access origin="https://calendar.google.com" subdomains="true"/>
    <access origin="https://icloud.com" subdomains="true"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
